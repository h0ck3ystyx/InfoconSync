[Unit]
Description=InfoCon Librarian NAS mirror manager
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/infocon
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=infocon
Group=infocon
WorkingDirectory=/var/lib/infocon-librarian
ExecStart=/opt/infocon-librarian/current/bin/infocon-server --config /etc/infocon-librarian/server.toml serve
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/infocon-librarian
StateDirectory=infocon-librarian
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/infocon-librarian /mnt/infocon

[Install]
WantedBy=multi-user.target
